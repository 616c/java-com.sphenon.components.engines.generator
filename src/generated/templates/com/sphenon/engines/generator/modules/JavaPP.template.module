protected Object resolveLocator(CallContext context, String text_locator, Object object) {
    try {
        return (Locator.createLocator(context, text_locator).retrieveTarget(context, object));
    } catch (InvalidLocator il) {
        CustomaryContext.create((Context)context).throwConfigurationError(context, il, "During generation, an invalid locator '%(locator)' was found in template '%(generatorid)'", "locator", text_locator, "generatorid", this.getId(context));
        throw (ExceptionConfigurationError) null; // compiler insists
    }
}
protected Object evaluateExpression(CallContext context, String expression, Object... arguments) {
    try {
        return Expression.evaluate(context, expression, null, arguments);
    } catch (EvaluationFailure ef) {
        CustomaryContext.create((Context)context).throwConfigurationError(context, ef, "During generation, an invalid expression '%(expression)' was found in template '%(generatorid)'", "expression", expression, "generatorid", this.getId(context));
        throw (ExceptionConfigurationError) null; // compiler insists
    }
}
