<?xml version="1.0" encoding="UTF-8"?>
<parser CLASS="TemplateParser" xmlns="http://xmlns.sphenon.com/com/sphenon/engines/generator">
  <TOMParser>
    <BeginHandler OID="mth" CLASS="TCHMain">
      <SourceHandler CLASS="TCHCompactUnicodeSyntax2ASCII">
        <ASCIISourceHandler OID="ash" CLASS="TCHLanguageDispatcher">
          <TextHandler CLASS="TCHText"/>
          <JavaCodeHandler CLASS="TCHJavaPP">
            <JavaCodeHandler CLASS="TCHJavaCode"/>
          </JavaCodeHandler>
          <JavaExpressionHandler CLASS="TCHJavaPP">
            <JavaCodeHandler CLASS="TCHJavaExpression"/>
          </JavaExpressionHandler>
          <TemplateCommentHandler CLASS="TCHTemplateComment"/>
          <TemplateCodeHandler OID="tch" CLASS="TCHTemplateCode">
            <JavaCodeHandler CLASS="TCHJavaPP">
              <JavaCodeHandler CLASS="TCHJavaCodeInTemplateCode">
                <TemplateCodeHandler OIDREF="tch"/>
              </JavaCodeHandler>
            </JavaCodeHandler>
          </TemplateCodeHandler>
          <TagHandler CLASS="TCHTag">
            <ASCIISourceHandler OIDREF="ash"/>
          </TagHandler>
          <PPTagHandler CLASS="TCHPPTag"/>
        </ASCIISourceHandler>
      </SourceHandler>
    </BeginHandler>
    <SourceHandler OIDREF="mth"/>
    <EndHandler OIDREF="mth"/>
    <IncludeModules OID="modules">
      <Module>com.sphenon.engines.generator.modules.JavaPP</Module>
    </IncludeModules>
  </TOMParser>
</parser>
