protected List<String> getJavaImports() {
    List<String> list = new ArrayList<String>(jimports);
    java.util.Collections.sort(list);
    return list;
}
protected JsonNode parseJSON(String json) {
    ObjectMapper mapper = new ObjectMapper();
    try {
        return mapper.readTree(json);
    } catch (java.io.IOException ioe) {
        ioe.printStackTrace();
        return null;
    }
}
protected Vector<Model> getModels() {
    if (this.models == null) {
        this.models = new Vector<Model>();
        this.models.add(this.model);
        for (String im : property("ImportedModels", "", "").split(",")) {
            if (im.isEmpty()) { continue; }
            String[] imp = im.split(":");
            if (imp[1].equals("file")) {
                String pfile = property_file.replaceFirst("[^/]+/?$","") + imp[2];
                Properties p = FileUtilities.loadPropertiesFrom(com.sphenon.basics.context.classes.RootContext.getFallbackCallContext(), pfile);
                String im_string = p.getProperty("Model");
                Model imodel = parseModel(im_string, imp[0], p);
                this.models.add(imodel);
            } else if (imp[1].equals("property")) {
                String im_string = property(imp[2], "ImportedModel.", "");
                Model imodel = parseModel(im_string, imp[0], properties);
                this.models.add(imodel);
            }
        }
    }
    return this.models;
}
protected int[] getBaseClassIndices(String[] cls) {
    if (cls.length > 4) {
        for (String base : cls[4].split("\\+")) {
            if ( ! base.isEmpty()) {
                int midx = 0;
                for (Model m : this.getModels()) {
                    for(int c=0; c<m.classes.size(); c++){
                        if (base.equals(m.classes.get(c)[0])) {
                            return new int[] { midx, c };
                        }
                    }
                    midx++;
                }                
            }
        }
    }
    return null;
}
protected Model parseModel(String model_string, String model_id, Properties properties) {
    model_string = model_string.replaceFirst("^\"","").replaceFirst("\"$","");
    Model model = new Model();
    model.id = model_id;
    model.properties = properties;
    for (String cls : model_string.split("[\\[\\]]+",-1)) {
        if (cls.matches("^[ \n\r\t]*$")) { continue; }
        String[] comps = (cls + "|-|-|-").split("\\|",-1);
        model.classes.add(comps[0].split(":",-1));
        Vector<String[]> attributes = new Vector<String[]>();
        model.class_attributes.add(attributes);
        for (String att : comps[1].split(";",-1)) {
            if (att.equals("-") == false) {
                if (att.matches("^[ \n\r\t]*$")) { continue; }
                attributes.add((att+":-:-").split(":",-1));
            }
        }
        model.class_operations.add(comps[2]);
        Vector<Vector<String[]>> signatures = new Vector<Vector<String[]>>();
        model.class_signatures.add(signatures);
        if (comps[3] != null && comps[3].isEmpty() == false && comps[3].equals("-") == false) {
            for (String sig : comps[3].split("/",-1)) {
                Vector<String[]> signature = new Vector<String[]>();
                signatures.add(signature);
                for (String sp : sig.split("[;()]",-1)) {
                    if (sp.matches("^[ \n\r\t]*$")) { continue; }
                    signature.add((sp+":-:-:-:-:-:-").split(":",-1)); 
                }
            }
        }
    }
    return model;
}
protected String getModelIDOfClass(String name) {
    for (Model model : getModels()) {
        for (String[] c : model.classes) {
            if (name.equals(c[0])) { return model.id; }
        }
    }
    return null;
}
