protected String value(String value, String prefix) { return ((value.isEmpty() || value.charAt(0) != '@') ? value : property(value.substring(1), prefix, "")); }
protected String valuePP(String value, String prefix, String vprefix, String vpostfix) { String result = ((value.isEmpty() || value.charAt(0) != '@') ? value : property(value.substring(1), prefix, "")); return (result == null || result.isEmpty() ? "" : (vprefix + result + vpostfix));}
protected String property(String key, String prefix, String default_value) { return property(properties, key, prefix, default_value, false); }
protected String property(String key, String prefix, String default_value, boolean required) { return property(properties, key, prefix, default_value, required); }
protected String property(Properties properties, String key, String prefix, String default_value) { return property(properties, key, prefix, default_value, false); }
protected String property(Properties properties, String key, String prefix, String default_value, boolean required) { String result = null; if (properties != null) { result = properties.getProperty(prefix + key); if (result == null) { result = properties.getProperty(key); } } if (result == null && required) { System.err.println("undefined property: " + prefix + key); } return result != null ? result : default_value; }
protected boolean isTrue(String value, String prefix) { String result = value(value, prefix); return (result != null && result.equals("true") ? true : false); }
protected boolean nonEmpty(String value, String prefix) { String result = value(value, prefix); return (result != null && result.isEmpty() == false ? true : false); }
protected String ifNonEmpty(String pkey, String pprefix, String prefix, String postfix) { return ifNonEmpty(pkey, pprefix, prefix, postfix, false); }
protected String ifNonEmpty(String pkey, String pprefix, String prefix, String postfix, boolean required) { if (pkey == null) { return ""; } String pvalue = property(pkey, pprefix, ""); if (pvalue != null && pvalue.isEmpty() == false) { return prefix + pvalue + postfix; } else { if (required) { System.err.println("undefined property: " + pprefix + pkey); } return ""; } }
protected boolean contains(String property, String value) { return contains(property, value, property_category); }
protected boolean contains(String property, String value, String wherein) { if (property == null) { return false; } matches = new RegularExpression(".*\\b" + value + "(:?" + wherein + ")?\\b.*").tryGetMatches(null, property); return matches != null; }
// protected boolean inModel(String property, String value) { return (contains(property, value) || ! contains(property, "EM|(?:T[0-9]+)")); }
protected String getBaseIfAppliesToModule(String string) { if (string == null || string.isEmpty()) { return null; } String[] parts = string.split("~", 2); if (parts.length < 2 || parts[1].matches(".*\\b(:?" + module_id + ")\\b.*")) { return parts[0]; } else return null; }
protected String ifAppliesToModule(String string, String prefix, String postfix) { String base = getBaseIfAppliesToModule(string); if (base != null) { return prefix + base + postfix; } else return ""; }
protected String tmap(String string) { String tm = property("TypeNameMapping", "transport.", null); if (tm == null || tm.isEmpty()) { return string; } else { String[] re = tm.split("#"); return string.replaceAll(re[0], re[1]); } }
protected String nullValue(String type) { if (type.matches("short|Short|int|Integer|long|Long")) { return "0"; } if (type.matches("float|Float|double|Double")) { return "0.0"; } return "null"; }
protected String recode_LCD_LCU_MC_CB(CallContext context, String string) { return Encoding.recode(context, Encoding.recode(context, Encoding.recode(context, string, Encoding.LCD, Encoding.LCU), Encoding.LCU, Encoding.MC), Encoding.MC, Encoding.CB); }
protected boolean strictness(int level) { return (t.i(property("Strictness","CodeCompliance.","0")) >= level) ? true : false; }
protected Vector<String> getMatchingImports(String module_id) {
    return getMatchingImports(module_id, null);
}
protected Vector<String> getMatchingImports(String module_id, String file_id) {
    Vector<String> imports = new Vector<String>();
    for (String jimport : java_imports.split(":")) {
        if (jimport != null && jimport.isEmpty() == false && jimport.equals("-") == false) {
            String[] jip = jimport.split("#");
            String minc = jip.length <= 1 ? null : jip[1];
            String mexc = jip.length <= 2 ? null : jip[2];
            String finc = jip.length <= 3 ? null : jip[3];
            String fexc = jip.length <= 4 ? null : jip[4];
            List<String> mincl = minc == null || minc.isEmpty() ? null : Arrays.asList(minc.split(","));
            List<String> mexcl = mexc == null || mexc.isEmpty() ? null : Arrays.asList(mexc.split(","));
            List<String> fincl = finc == null || finc.isEmpty() ? null : Arrays.asList(finc.split(","));
            List<String> fexcl = fexc == null || fexc.isEmpty() ? null : Arrays.asList(fexc.split(","));
            if (    (mincl == null || mincl.contains(module_id))
                 && (mexcl == null || ! mexcl.contains(module_id))
                 && (    file_id == null
                      || (    (fincl == null || fincl.contains(file_id))
                           && (fexcl == null || ! fexcl.contains(file_id))
                         )
                    )
               ) {
                imports.add(jip[0]);
            }
        }
    }
    return imports;
}
protected void addMatchingModuleFileImports(String module_id, String file_id) {
    for (String jimport : getMatchingImports(module_id, file_id)) {
        jimports.add(jimport);
    }
}
protected void addBaseClassImports(String[] cls) {
    if (cls.length > 4) {
        for (String fullbase : cls[4].split("\\+")) {
            String base = getBaseIfAppliesToModule(fullbase);
            if (base != null) {
                got_bases = true;
                String mioc = getModelIDOfClass(base);
                if (mioc != null) {
                    jimports.add("com.lhsystems.velimo." + mioc + ".business.entity." + base);
                }
            }
        }
    }
}
protected void addTypeImport(String type) {
    for (String part : type.split("[<,>]")) {
        if (part.isEmpty() == false) {
            addClassImport(part);
        }
    }
}
protected void addClassImport(String[] cls) {
    addClassImport(cls[0]);
}
protected void addClassImport(String cls) {
    String mioc = getModelIDOfClass(cls);
    if (mioc != null) {
        jimports.add("com.lhsystems.velimo." + mioc + ".business.entity." + cls);
    }
}
protected void addClassImports(String[] cls) {
    for (String jimport : property(cls[0] + ".imports", "entity-model.POJO.", "").split(",")) {
        if (jimport.isEmpty() == false) {
            jimports.add(jimport);
        }
    }
}
protected void addMemberImports(Vector<String[]> attributes) {
    for (int a=0; a<attributes.size(); a++) {
        if (contains(attributes.get(a)[3], "EM") == false) { continue; }
        if (contains(attributes.get(a)[3], "CA")) { continue; }
        addTypeImport(attributes.get(a)[2]);
    }
}
protected void addArgumentImports(String module_id, String[] cls, String operations, Vector<String[]> attributes, Vector<Vector<String[]>> signatures) {
    for (int a=0; a<attributes.size(); a++) {
        boolean use = false;
        if (use == false) {
            if (operations.matches(".*\\bF(:?repository)?\\b.*")) {
                for (String findmethod : property(cls[0] + ".findMethods", module_id + ".", "0:").split(",")) {
                    String[] fm = findmethod.split(":",-2); String fi = fm[0]; String fn = fm[1]; boolean fc = fi.equals("0"); String fnsep = fn.isEmpty() ? "" : (" " + fn);
                    if (contains(attributes.get(a)[3], "EM") == false) { continue; }
                    if (contains(attributes.get(a)[3], "F"+fi) == false) { continue; }
                    use = true;
                    break;
                }
            }
        }
        if (use == false) {
            if (operations.matches(".*\\bC(:?repository)?\\b.*")) {
                if (    contains(attributes.get(a)[3], "EM") == true
                     && contains(attributes.get(a)[3], "CA") == false) {
                    use = true;
                }
            }
        }
        if (use == false) {
            if (operations.matches(".*\\bR(:?repository)?\\b.*")) {
                if (    contains(attributes.get(a)[3], "EM")
                     && contains(attributes.get(a)[3], "PK")
                   ) {
                    use = true;
                }
            }
        }
        if (use == false) {
            if (operations.matches(".*\\bU(:?repository)?\\b.*")) {
                if (    contains(attributes.get(a)[3], "EM")
                     && (    contains(attributes.get(a)[3], "CA") == false
                          || contains(attributes.get(a)[3], "PK")
                        )
                   ) {
                    use = true;
                }
            }
        }
        if (use == false) {
            if (operations.matches(".*\\bD(:?repository)?\\b.*")) {
                if (    contains(attributes.get(a)[3], "EM")
                     && contains(attributes.get(a)[3], "PK")
                   ) {
                    use = true;
                }
            }
        }
        if (use) {
            addTypeImport(attributes.get(a)[2]);
        }
        if (use == false) {
            for (int s=0; s<signatures.size(); s++) {
                if (contains(signatures.get(s).get(0)[5], "I", module_id)) {
                addTypeImport(signatures.get(s).get(0)[0]);
                for (int p=1; p<signatures.get(s).size(); p++) {
                    if (contains(signatures.get(s).get(p)[4], "I", module_id) == false && contains(signatures.get(s).get(p)[4], "I", "[a-z0-9-]+")) { continue; }
                        addTypeImport(signatures.get(s).get(p)[2]);
                    }
                }
            }
        }
    }
}
protected void addJavaImports(String... jis) {
    for (String jimport : jis) {
